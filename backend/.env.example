# Karobar Backend Configuration
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Authentication & Security (Min 32 characters for production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Redis (BullMQ Queues & Multi-instance Financial Intelligence Cache)
REDIS_URL=redis://127.0.0.1:6379

# Google Gemini AI (FinVoice & Business Intelligence)
GEMINI_API_KEY=your-google-gemini-api-key

# Transactional Email (Optional)
EMAIL_USER=notifications@yourbusiness.com
EMAIL_PASS=your-smtp-app-password
